---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Engineering Logs">
  <section class="mb-10">
    <h1 class="text-2xl font-semibold tracking-tight text-neutral-100 mb-2 font-mono">Official Development Blog For OpenVMM</h1>
    <p class="text-neutral-400 text-sm">Dispatches on progress, architecture, and tools.</p>
  </section>

  <ul class="space-y-4">
    {posts.map((post) => (
      <li class="group">
        <a href={`/blog/${post.id}`} class="block p-4 rounded-lg border border-neutral-900 bg-neutral-900/40 hover:bg-neutral-900 hover:border-neutral-800 transition-all">
          <div class="flex items-center justify-between text-xs font-mono text-neutral-500 mb-2">
            <span>{post.data.pubDate.toISOString().split('T')[0]}</span>
            <span class="text-neutral-600 group-hover:text-cyan-500 transition-colors">ID: {post.id} &rarr;</span>
          </div>
          <h2 class="text-base font-medium text-neutral-200 group-hover:text-cyan-400 transition-colors">
            {post.data.title}
          </h2>
          <p class="text-sm text-neutral-400 mt-1 line-clamp-2">
            {post.data.description}
          </p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>